# MemberFrame Plugin & Frontend Configuration

# Point to your local development backend server.
#
# When this is plain http on loopback (127.0.0.1, localhost), `npm run dev`
# forwards /api to it and the panel calls its own https origin instead. The
# panel runs inside framer.com, and browsers drop a request from there to an
# http loopback port before it is sent. See src/config/devProxy.ts.
#
# Restart `npm run dev` after changing this value.
VITE_API_BASE_URL="http://127.0.0.1:4000"
